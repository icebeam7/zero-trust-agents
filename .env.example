# Generated from Bicep outputs (copy to .env and adjust)
AZURE_SEARCH_ENDPOINT=https://YOUR_SEARCH.search.windows.net
AZURE_SEARCH_INDEX=company-knowledge
AZURE_STORAGE_ACCOUNT=YOURSTORAGE
AZURE_BLOB_ACCOUNT_URL=https://YOURSTORAGE.blob.core.windows.net
AZURE_OPENAI_BASE_URL=https://YOURFOUNDRY.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Microsoft Entra tenant and API application ID, created by setup-auth.sh
AZURE_TENANT_ID=
INTERNAL_API_APP_ID=
# Internal app URLs populated after ACA deployment
ANALYST_URL=http://analyst
REPORTER_URL=http://reporter
# For managed identity use matching UAMI client ID; locally leave empty
AZURE_CLIENT_ID=
# Enable ONLY for testing request chains locally, not public production
DEMO_TENANT=contoso
